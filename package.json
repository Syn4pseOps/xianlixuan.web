{
	"name": "twilight",
	"type": "module",
	"version": "1.0.0",
	"description": "A blog template",
	"scripts": {
		"type-check": "tsc --noEmit --isolatedDeclarations",
		"check-stylus": "node scripts/compile-inline-stylus.cjs",
		"check": "astro check",
		"security:audit": "pnpm audit --prod --audit-level=critical",
		"security:assets": "node scripts/validate-public-assets.cjs",
		"security:artifacts": "node scripts/validate-production-artifacts.cjs",
		"security:config": "node scripts/check-security-config.cjs",
		"security:check": "pnpm security:audit && pnpm security:assets && pnpm security:config && pnpm check && pnpm build",
		"dev": "node scripts/generate-icons.js && astro dev",
		"build": "node scripts/build-with-pagefind.cjs",
		"preview": "astro preview",
		"astro": "astro",
		"new-post": "node scripts/new-post.js"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.2",
		"@astrojs/svelte": "7.2.5",
		"@expressive-code/core": "^0.44.1",
		"@expressive-code/plugin-collapsible-sections": "^0.44.1",
		"@expressive-code/plugin-line-numbers": "^0.44.1",
		"@fancyapps/ui": "^6.1.14",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@iconify-json/eos-icons": "^1.2.4",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.69",
		"@iconify/svelte": "^5.2.1",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"@types/js-yaml": "^4.0.9",
		"astro": "5.18.2",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.2.0",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.20",
		"echarts": "^6.1.0",
		"hastscript": "^9.0.1",
		"js-yaml": "^4.3.1",
		"katex": "^0.18.4",
		"markdown-it": "^14.3.0",
		"mdast-util-to-string": "^4.0.0",
		"node-html-parser": "^7.1.0",
		"pagefind": "^1.5.2",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-callouts": "^2.2.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^0.4.2",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.7",
		"satori": "^0.33.3",
		"sharp": "^0.35.3",
		"stylus": "^0.64.0",
		"svelte": "^5.56.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.7",
		"@iconify-json/mdi": "^1.2.3",
		"@rollup/plugin-yaml": "^4.1.2",
		"@types/hast": "^3.0.4",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.1",
		"javascript-obfuscator": "5.6.0",
		"postcss-import": "^16.2.0"
	},
	"packageManager": "pnpm@9.14.4"
}
