---
import { navbarConfig, siteConfig } from "@/config";
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset, type NavbarLink } from "@/types/config";
import { url } from "@utils/url";
import NavMenu from "@components/navbar/navMenu.svelte";
import Search from "@components/navbar/search.svelte";
import Translator from "@components/navbar/translator.svelte";

const normalizePath = (path: string) => {
    const normalized = path.replace(/\/+$/, "");
    return normalized || "/";
};

type LocalizedNavbarLink = NavbarLink & { thaiName: string };

const thaiNavLabels: Record<string, string> = {
    "/": "จุดเริ่มต้น",
    "/hall-of-fame": "หอจารึก",
    "/blog": "บันทึกเร้นลับ",
    "/archive": "คลังต้องห้าม",
    "/about": "ปฐมบท",
};

const links: LocalizedNavbarLink[] = navbarConfig.links.map(
    (item: NavbarLink | LinkPreset): LocalizedNavbarLink => {
        const link = typeof item === "number" ? LinkPresets[item] : item;
        const linkPath = link.external ? link.url : normalizePath(url(link.url));
        return { ...link, thaiName: thaiNavLabels[linkPath] ?? link.name };
    },
);

const currentPath = normalizePath(Astro.url.pathname);
const navbarWordmark = "yn4pseOps".split("");
const isCurrent = (link: NavbarLink) => {
    if (link.external) return false;
    const linkPath = normalizePath(url(link.url));
    if (linkPath === "/blog" && currentPath.startsWith("/posts/")) return true;
    return linkPath === "/"
        ? currentPath === "/"
        : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
};
---

<a class="skip-link" href="#swup-container">Skip to content</a>

<header id="navbar" class="onload-animation-down">
    <div class="navbar-inner">
        <a href={url("/")} class="navbar-brand notranslate" aria-label={`Go to ${siteConfig.title} homepage`}>
            <img
                class="navbar-mark"
                src={url("/assets/brand/syna4pseops-mark.png")}
                alt=""
                width="512"
                height="512"
                aria-hidden="true"
            />
            <span class="navbar-wordmark" aria-label="yn4pseOps">
                <span class="navbar-wordmark-letters" aria-hidden="true">
                    {navbarWordmark.map((letter) => <span>{letter}</span>)}
                </span>
            </span>
        </a>

        <nav class="navbar-primary" aria-label="Primary">
            {links.map((link) => (
                <a
                    href={link.external ? link.url : url(link.url)}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class:list={["navbar-link notranslate", { "is-current": isCurrent(link) }]}
                    aria-current={isCurrent(link) ? "page" : undefined}
                >
                    <span class="navbar-label navbar-label-en">{link.name}</span>
                    <span class="navbar-label navbar-label-th" lang="th">{link.thaiName}</span>
                </a>
            ))}
        </nav>

        <div class="navbar-actions" id="navbar-buttons">
            <Translator client:idle />
            <Search client:idle />
            <NavMenu client:idle links={links} />
        </div>
    </div>
</header>

<script is:inline>
    (() => {
        const normalizePath = (value) => {
            const normalized = value.replace(/\/+$/, "");
            return normalized || "/";
        };

        const syncActiveNavigation = () => {
            const currentPath = normalizePath(window.location.pathname);
            document.querySelectorAll("#navbar .navbar-primary .navbar-link").forEach((link) => {
                const linkPath = normalizePath(new URL(link.href, window.location.origin).pathname);
                const isPostRoute = linkPath === "/blog" && currentPath.startsWith("/posts/");
                const isCurrent = isPostRoute || (linkPath === "/"
                    ? currentPath === "/"
                    : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`));

                link.classList.toggle("is-current", isCurrent);
                if (isCurrent) {
                    link.setAttribute("aria-current", "page");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
        };

        if (!window.__syna4pseOpsNavSync) {
            window.__syna4pseOpsNavSync = true;
            document.addEventListener("astro:after-swap", syncActiveNavigation);
            document.addEventListener("swup:contentReplaced", syncActiveNavigation);
            window.addEventListener("popstate", syncActiveNavigation);
        }

        syncActiveNavigation();
    })();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) throw new Error(`Pagefind script not found: ${response.status}`);
        const pagefind = await import(scriptUrl);
        await pagefind.options({ excerptLength: 20 });
        window.pagefind = pagefind;
        document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (_) {
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
