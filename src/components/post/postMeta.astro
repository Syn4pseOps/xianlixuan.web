---
import { Icon } from "astro-icon/components";

import { getCategoryUrl, getTagUrl, url } from "@utils/url";
import { getCategoryPathParts } from "@utils/category";
import { formatDateToYYYYMMDD } from "@utils/date";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";


export interface Props {
    published: Date;
    updated?: Date;
    category?: string | string[] | null;
    tags?: string[];
    hideUpdateDate?: boolean;
    hideTagsForMobile?: boolean;
    isHome?: boolean;
    className?: string;
    compact?: boolean;
    slug?: string;
    postUrl?: string;
}

const {
    published,
    updated,
    category,
    tags,
    hideUpdateDate,
    hideTagsForMobile,
    isHome,
    className = "",
    compact = false
} = Astro.props;
const categoryParts = getCategoryPathParts(category ?? null);
const metaWrapClass = compact ? "gap-x-3 gap-y-1.5" : "gap-x-4 gap-y-2";
const metaIconClass = compact ? "text-[1.05rem]" : "text-xl";
const metaTextClass = compact ? "text-[0.82rem]" : "text-sm";
const metaDividerClass = compact
    ? "mx-1 text-(--meta-divider) text-[0.78rem]"
    : "mx-1.5 text-(--meta-divider) text-sm";

---

<div class:list={["flex flex-wrap text-neutral-500 dark:text-neutral-400 items-center", metaWrapClass, className]}>
    <!-- publish date -->
    <div class="flex items-center">
        <div class="meta-icon">
            <Icon name="material-symbols:calendar-today-outline-rounded" class={metaIconClass}></Icon>
        </div>
        <span class:list={["text-50 font-medium", metaTextClass]}>{formatDateToYYYYMMDD(published)}</span>
    </div>
    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
            <div class="meta-icon">
                <Icon name="material-symbols:edit-calendar-outline-rounded" class={metaIconClass}></Icon>
            </div>
            <span class:list={["text-50 font-medium", metaTextClass]}>{formatDateToYYYYMMDD(updated)}</span>
        </div>
    )}
    <!-- categories -->
    <div class="flex items-center">
        <div class="meta-icon">
            <Icon name="material-symbols:book-2-outline-rounded" class={metaIconClass}></Icon>
        </div>
        <div class="flex flex-row flex-nowrap items-center">
            {categoryParts && categoryParts.length > 0 ? (
                categoryParts.map((categoryName, index) => (
                    <>
                        {index > 0 && (
                            <div class={metaDividerClass}>/</div>
                        )}
                        <a
                            href={getCategoryUrl(categoryParts.slice(0, index + 1))}
                            aria-label={`View all posts in the ${categoryName} category`}
                            class:list={["link-lg transition text-50 font-medium",
                                metaTextClass,
                                "hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"]}
                        >
                            {categoryName}
                        </a>
                    </>
                ))
            ) : (
                <a href={getCategoryUrl(null)} aria-label={`View all posts in the ${i18n(I18nKey.uncategorized)} category`}
                    class:list={["link-lg transition text-50 font-medium",
                        metaTextClass,
                        "hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"]}>
                    {i18n(I18nKey.uncategorized)}
                </a>
            )}
        </div>
    </div>
    <!-- tags -->
    <div class:list={["items-center", {"flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile}]}>
        <div class="meta-icon">
            <Icon name="material-symbols:tag-rounded" class={metaIconClass}></Icon>
        </div>
        <div class="flex flex-row flex-nowrap items-center">
            {(tags && tags.length > 0) && tags.map((tag, i) => (
                <div class:list={[{"hidden": i == 0}, metaDividerClass]}>/</div>
                <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
                    class:list={["link-lg transition text-50 font-medium",
                        metaTextClass,
                        "hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"]}>
                    {tag.trim()}
                </a>
            ))}
            {!(tags && tags.length > 0) && <div class:list={["transition text-50 font-medium", metaTextClass]}>{i18n(I18nKey.noTags)}</div>}
        </div>
    </div>
</div>
