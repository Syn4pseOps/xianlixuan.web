---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { postConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@utils/date";
import { getPostUrl } from "@utils/url";
import ImageWrapper from "@components/common/imageWrapper.astro";

interface Props {
    class?: string;
    entry: CollectionEntry<"posts">;
    style?: string;
    caseNumber?: string;
}

const { entry, style, class: className, caseNumber } = Astro.props;
const postUrl = getPostUrl(entry);
const { title, published, description, category, cover } = entry.data;
const { remarkPluginFrontmatter } = await render(entry);
const categoryLabel = Array.isArray(category) ? category.join(" / ") : category || "Field Note";
const publishedDate = new Date(published);
const dateText = formatDateToYYYYMMDD(publishedDate).replaceAll("-", ".");
const year = publishedDate.getFullYear();
const coverSide = postConfig.card.cover.side === "right" ? "right" : "left";
const coverWidth = postConfig.card.cover.width || "33%";
---

<article
    class:list={["record-card", { "has-cover": !!cover, [`cover-${coverSide}`]: !!cover }, className]}
    style={[style, cover ? `--cover-width: ${coverWidth}` : ""].filter(Boolean).join("; ")}
>
    <a href={postUrl}>
        {cover && (
            <ImageWrapper
                class="record-cover"
                src={cover}
                alt={`${title} cover`}
                loading="lazy"
            />
        )}

        <div class="record-body">
            <span class="record-watermark" aria-hidden="true">Classified</span>

            <div class="record-id">
                <span class="record-case-chip">
                    <span class="record-pulse-dot" aria-hidden="true"></span>
                    {caseNumber && <>Case No. {caseNumber} / {year}</>}
                </span>
                <span class="record-category-pill">{categoryLabel}</span>
            </div>

            <h2>{title}</h2>

            <ul class="record-details">
                <li>
                    <span class="record-detail-label">Date</span>
                    <span class="record-detail-leader" aria-hidden="true"></span>
                    <time class="record-detail-value" datetime={formatDateToYYYYMMDD(publishedDate)}>{dateText}</time>
                </li>
                <li>
                    <span class="record-detail-label">Tags</span>
                    <span class="record-detail-leader" aria-hidden="true"></span>
                    <span class="record-detail-value">{categoryLabel}</span>
                </li>
                <li>
                    <span class="record-detail-label">Views</span>
                    <span class="record-detail-leader" aria-hidden="true"></span>
                    <span class="record-detail-value record-view-count" data-post-views={entry.id} aria-busy="true">···</span>
                </li>
            </ul>

            <p class="record-excerpt">{description || remarkPluginFrontmatter.excerpt}</p>

            <span class="record-open">Open file <span aria-hidden="true">→</span></span>
        </div>
    </a>
</article>

<script>
    const bindPostViewCounters = async () => {
        const counters = document.querySelectorAll<HTMLElement>(
            ".record-view-count[data-post-views]:not([data-view-counter-bound])",
        );

        await Promise.allSettled(
            Array.from(counters).map(async (counter) => {
                counter.dataset.viewCounterBound = "true";
                const postId = counter.dataset.postViews;
                if (!postId) return;

                const namespace = "syna4pseops-website";
                const key = `post-${postId}`;
                const sessionKey = `view-counter:${namespace}:${key}`;
                let countedThisSession = false;

                try {
                    countedThisSession = sessionStorage.getItem(sessionKey) === "1";
                } catch {
                    // The counter still works when session storage is unavailable.
                }

                const action = countedThisSession ? "get" : "hit";

                try {
                    const response = await fetch(
                        `https://abacus.jasoncameron.dev/${action}/${namespace}/${key}`,
                    );
                    if (!response.ok) throw new Error(String(response.status));

                    const result = await response.json();
                    const count =
                        typeof result?.value === "number"
                            ? result.value
                            : typeof result?.count === "number"
                              ? result.count
                              : null;
                    if (count === null) throw new Error("Invalid counter response");

                    counter.textContent = count.toLocaleString();
                    counter.removeAttribute("aria-busy");

                    if (!countedThisSession) {
                        try {
                            sessionStorage.setItem(sessionKey, "1");
                        } catch {
                            // Ignore storage errors after a successful count.
                        }
                    }
                } catch {
                    counter.textContent = "—";
                    counter.removeAttribute("aria-busy");
                }
            }),
        );
    };

    bindPostViewCounters();
    document.addEventListener("astro:after-swap", bindPostViewCounters);
</script>

<style>
    .record-card {
        position: relative;
        border: 1px solid rgba(216, 212, 202, 0.12);
        background: #060606;
        transition: border-color 180ms ease, transform 180ms ease;
    }

    .record-card:hover {
        border-color: rgba(112, 33, 49, 0.82);
        transform: translateY(-2px);
    }

    .record-card::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 2;
        width: 2px;
        background: rgba(112, 33, 49, 0.22);
        transition: background 220ms ease, box-shadow 220ms ease;
    }

    .record-card:hover::before {
        background: rgba(112, 33, 49, 0.95);
        box-shadow: 0 0 8px rgba(112, 33, 49, 0.6), 0 0 20px rgba(112, 33, 49, 0.3);
    }

    .record-card a {
        display: flex;
        color: inherit;
        text-decoration: none;
    }

    .record-card a:hover h2 {
        color: #eeeae1;
    }

    .record-card.cover-right a {
        flex-direction: row-reverse;
    }

    .record-card.has-cover .record-cover {
        flex: 0 0 var(--cover-width, 33%);
        aspect-ratio: 4 / 3;
        align-self: stretch;
    }

    .record-card.has-cover .record-cover :global(img) {
        transition: transform 220ms ease, filter 220ms ease;
        filter: saturate(0.85) contrast(1.02);
    }

    .record-card.has-cover:hover .record-cover :global(img) {
        transform: scale(1.03);
        filter: saturate(1) contrast(1.04);
    }

    .record-body {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
        padding: 1.1rem 1.25rem 1.25rem;
        overflow: hidden;
    }

    .record-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: -1;
        color: rgba(238, 234, 225, 0.035);
        font-family: var(--font-mono);
        font-size: 2.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
        transform: translate(-50%, -50%) rotate(-16deg);
        pointer-events: none;
        user-select: none;
    }

    .record-id {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .record-case-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(238, 234, 225, 0.58);
        font-family: var(--font-mono);
        font-size: 0.64rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .record-pulse-dot {
        width: 0.32rem;
        height: 0.32rem;
        flex: 0 0 auto;
        border-radius: 50%;
        background: rgba(238, 234, 225, 0.4);
    }

    @media (prefers-reduced-motion: no-preference) {
        .record-pulse-dot {
            animation: synapse-dot-pulse 3.6s ease-in-out infinite;
        }
    }

    .record-category-pill {
        display: inline-block;
        border: 1.5px solid var(--accent-strong, #702131);
        padding: 0.25rem 0.7rem;
        color: var(--accent-strong, #702131);
        font-family: var(--font-mono);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        transform: rotate(-3deg);
        transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .record-card:hover .record-category-pill {
        color: #fffdf8;
        border-color: #fffdf8;
        transform: rotate(-3deg) scale(1.04);
    }

    .record-card h2 {
        margin: 0.85rem 0 0;
        color: rgba(244, 241, 234, 0.94);
        font-size: 1.38rem;
        font-weight: 500;
        line-height: 1.3;
    }

    .record-details {
        display: flex;
        flex-direction: column;
        gap: 0.32rem;
        margin: 0.8rem 0 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
    }

    .record-details li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .record-detail-label {
        flex: 0 0 auto;
        color: rgba(216, 212, 202, 0.5);
        letter-spacing: 0.04em;
    }

    .record-detail-leader {
        flex: 1 1 auto;
        min-width: 0.5rem;
        border-bottom: 1px dotted rgba(216, 212, 202, 0.24);
        margin-bottom: 0.22rem;
    }

    .record-detail-value {
        flex: 0 0 auto;
        color: rgba(238, 234, 225, 0.8);
    }

    .record-excerpt {
        margin: 0.75rem 0 0;
        color: rgba(238, 234, 225, 0.72);
        font-size: 0.94rem;
        font-style: italic;
        line-height: 1.55;
    }

    .record-open {
        display: inline-block;
        margin-top: 1rem;
        color: var(--accent-strong, #702131);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: color 160ms ease;
    }

    .record-card:hover .record-open {
        color: #fffdf8;
    }

    @media (max-width: 520px) {
        .record-card h2 {
            font-size: 1.22rem;
        }

        .record-card a,
        .record-card.cover-right a {
            flex-direction: column;
        }

        .record-card.has-cover .record-cover {
            flex-basis: auto;
            width: 100%;
            aspect-ratio: 16 / 9;
        }

        .record-body {
            padding: 1rem;
        }
    }
</style>
