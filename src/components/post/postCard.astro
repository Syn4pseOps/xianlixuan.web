---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { formatDateToYYYYMMDD } from "@utils/date";
import { getPostUrl } from "@utils/url";

interface Props {
    class?: string;
    entry: CollectionEntry<"posts">;
    style?: string;
}

const { entry, style, class: className } = Astro.props;
const postUrl = getPostUrl(entry);
const { title, published, description, category, pinned } = entry.data;
const { remarkPluginFrontmatter } = await render(entry);
const categoryLabel = Array.isArray(category) ? category.join(" / ") : category || "Field Note";
const dateText = formatDateToYYYYMMDD(new Date(published)).replaceAll("-", ".");
---

<article class:list={["record-card", className]} style={style}>
    <a href={postUrl}>
        <div class="record-meta">
            <span>{pinned ? "Priority" : "Case file"}</span>
            <time datetime={formatDateToYYYYMMDD(new Date(published))}>{dateText}</time>
            <span>{categoryLabel}</span>
        </div>

        <h2>{title}</h2>
        <p>{description || remarkPluginFrontmatter.excerpt}</p>

        <div class="record-foot">
            <span>{remarkPluginFrontmatter.words} words</span>
            <span>{remarkPluginFrontmatter.minutes} min read</span>
            <span aria-hidden="true">Read record →</span>
        </div>
    </a>
</article>

<style>
    .record-card {
        border-top: 1px solid rgba(216, 212, 202, 0.1);
    }

    .record-card:last-child {
        border-bottom: 1px solid rgba(216, 212, 202, 0.1);
    }

    .record-card a {
        display: block;
        padding: 1.35rem 0;
        color: inherit;
        text-decoration: none;
    }

    .record-card a:hover h2 {
        color: #eeeae1;
    }

    .record-meta,
    .record-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem 1rem;
        color: rgba(216, 212, 202, 0.36);
        font-family: var(--font-mono);
        font-size: 0.63rem;
        text-transform: uppercase;
    }

    .record-meta span:first-child {
        color: #9a4552;
    }

    .record-card h2 {
        margin: 0.65rem 0 0;
        color: rgba(216, 212, 202, 0.82);
        font-size: 1.38rem;
        font-weight: 500;
        line-height: 1.3;
    }

    .record-card p {
        margin: 0.55rem 0 0;
        color: rgba(216, 212, 202, 0.54);
        font-size: 0.98rem;
        line-height: 1.55;
    }

    .record-foot {
        margin-top: 0.85rem;
    }

    .record-foot span:last-child {
        margin-left: auto;
        color: rgba(216, 212, 202, 0.56);
    }

    @media (max-width: 520px) {
        .record-card h2 {
            font-size: 1.22rem;
        }

        .record-foot span:last-child {
            width: 100%;
            margin-left: 0;
        }
    }
</style>
