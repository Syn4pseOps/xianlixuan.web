---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { postConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@utils/date";
import { getPostUrl } from "@utils/url";
import ImageWrapper from "@components/common/imageWrapper.astro";

interface Props {
    class?: string;
    entry: CollectionEntry<"posts">;
    style?: string;
    caseNumber?: string;
}

const { entry, style, class: className, caseNumber } = Astro.props;
const postUrl = getPostUrl(entry);
const { title, published, description, category, cover } = entry.data;
const { remarkPluginFrontmatter } = await render(entry);
const categoryLabel = Array.isArray(category) ? category.join(" / ") : category || "Field Note";
const dateText = formatDateToYYYYMMDD(new Date(published)).replaceAll("-", ".");
const coverSide = postConfig.card.cover.side === "right" ? "right" : "left";
const coverWidth = postConfig.card.cover.width || "33%";
---

<article
    class:list={["record-card", { "has-cover": !!cover, [`cover-${coverSide}`]: !!cover }, className]}
    style={[style, cover ? `--cover-width: ${coverWidth}` : ""].filter(Boolean).join("; ")}
>
    <a href={postUrl}>
        {cover && (
            <ImageWrapper
                class="record-cover"
                src={cover}
                alt={`${title} cover`}
                loading="lazy"
            />
        )}

        <div class="record-body">
            <span class="record-watermark" aria-hidden="true">Classified</span>

            <div class="record-id">
                <span class="record-case-chip">
                    <span class="record-pulse-dot" aria-hidden="true"></span>
                    {caseNumber && <><span class="bracket">[</span>{caseNumber}<span class="bracket">]</span></>}
                </span>
                <span class="record-category-pill">{categoryLabel}</span>
            </div>

            <h2>{title}</h2>

            <p class="record-meta-line">
                <time datetime={formatDateToYYYYMMDD(new Date(published))}>{dateText}</time>
                <span class="record-meta-sep" aria-hidden="true">/</span>
                <span>{remarkPluginFrontmatter.minutes} min read</span>
                <span class="record-meta-sep" aria-hidden="true">/</span>
                <span>{remarkPluginFrontmatter.words} words</span>
            </p>

            <p class="record-excerpt">{description || remarkPluginFrontmatter.excerpt}</p>
        </div>

        <span class="record-arrow" aria-hidden="true">→</span>
    </a>
</article>

<style>
    .record-card {
        position: relative;
        border: 1px solid rgba(216, 212, 202, 0.12);
        background: #060606;
        transition: border-color 180ms ease, transform 180ms ease;
    }

    .record-card:hover {
        border-color: rgba(112, 33, 49, 0.82);
        transform: translateY(-2px);
    }

    .record-card::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 2;
        width: 2px;
        background: rgba(112, 33, 49, 0.22);
        transition: background 220ms ease, box-shadow 220ms ease;
    }

    .record-card:hover::before {
        background: rgba(112, 33, 49, 0.95);
        box-shadow: 0 0 8px rgba(112, 33, 49, 0.6), 0 0 20px rgba(112, 33, 49, 0.3);
    }

    .record-card a {
        display: flex;
        color: inherit;
        text-decoration: none;
    }

    .record-card a:hover h2 {
        color: #eeeae1;
    }

    .record-card.cover-right a {
        flex-direction: row-reverse;
    }

    .record-card.has-cover .record-cover {
        flex: 0 0 var(--cover-width, 33%);
        aspect-ratio: 4 / 3;
        align-self: stretch;
    }

    .record-card.has-cover .record-cover :global(img) {
        transition: transform 220ms ease, filter 220ms ease;
        filter: saturate(0.85) contrast(1.02);
    }

    .record-card.has-cover:hover .record-cover :global(img) {
        transform: scale(1.03);
        filter: saturate(1) contrast(1.04);
    }

    .record-body {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
        padding: 1.1rem 2.75rem 1.25rem 1.25rem;
        overflow: hidden;
    }

    .record-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: -1;
        color: rgba(238, 234, 225, 0.035);
        font-family: var(--font-mono);
        font-size: 2.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
        transform: translate(-50%, -50%) rotate(-16deg);
        pointer-events: none;
        user-select: none;
    }

    .record-id {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .record-case-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(238, 234, 225, 0.6);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.03em;
    }

    .record-case-chip .bracket {
        color: var(--accent-strong, #702131);
    }

    .record-pulse-dot {
        width: 0.32rem;
        height: 0.32rem;
        border-radius: 50%;
        background: rgba(238, 234, 225, 0.4);
    }

    @media (prefers-reduced-motion: no-preference) {
        .record-pulse-dot {
            animation: synapse-dot-pulse 3.6s ease-in-out infinite;
        }
    }

    .record-category-pill {
        display: inline-block;
        border: 1.5px solid var(--accent-strong, #702131);
        padding: 0.25rem 0.7rem;
        color: var(--accent-strong, #702131);
        font-family: var(--font-mono);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        transform: rotate(-3deg);
        transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .record-card:hover .record-category-pill {
        color: #fffdf8;
        border-color: #fffdf8;
        transform: rotate(-3deg) scale(1.04);
    }

    .record-card h2 {
        margin: 0.85rem 0 0;
        color: rgba(244, 241, 234, 0.94);
        font-size: 1.38rem;
        font-weight: 500;
        line-height: 1.3;
    }

    .record-meta-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0.6rem 0 0;
        color: rgba(216, 212, 202, 0.56);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .record-meta-sep {
        color: rgba(216, 212, 202, 0.28);
    }

    .record-excerpt {
        margin: 0.75rem 0 0;
        color: rgba(238, 234, 225, 0.72);
        font-size: 0.94rem;
        font-style: italic;
        line-height: 1.55;
    }

    .record-arrow {
        position: absolute;
        right: 1.1rem;
        bottom: 1rem;
        color: rgba(216, 212, 202, 0.5);
        font-size: 1.05rem;
        transition: color 160ms ease, transform 160ms ease;
    }

    .record-card:hover .record-arrow {
        color: var(--accent-strong, #702131);
        transform: translateX(0.2rem);
    }

    @media (max-width: 520px) {
        .record-card h2 {
            font-size: 1.22rem;
        }

        .record-card a,
        .record-card.cover-right a {
            flex-direction: column;
        }

        .record-card.has-cover .record-cover {
            flex-basis: auto;
            width: 100%;
            aspect-ratio: 16 / 9;
        }

        .record-body {
            padding: 1rem 2.25rem 1rem 1rem;
        }
    }
</style>
