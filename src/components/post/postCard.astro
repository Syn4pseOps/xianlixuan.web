---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { postConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@utils/date";
import { getPostUrl } from "@utils/url";
import ImageWrapper from "@components/common/imageWrapper.astro";

interface Props {
    class?: string;
    entry: CollectionEntry<"posts">;
    style?: string;
}

const { entry, style, class: className } = Astro.props;
const postUrl = getPostUrl(entry);
const { title, published, description, category, pinned, cover } = entry.data;
const { remarkPluginFrontmatter } = await render(entry);
const categoryLabel = Array.isArray(category) ? category.join(" / ") : category || "Field Note";
const dateText = formatDateToYYYYMMDD(new Date(published)).replaceAll("-", ".");
const coverSide = postConfig.card.cover.side === "right" ? "right" : "left";
const coverWidth = postConfig.card.cover.width || "33%";
---

<article
    class:list={["record-card", { "has-cover": !!cover, [`cover-${coverSide}`]: !!cover }, className]}
    style={[style, cover ? `--cover-width: ${coverWidth}` : ""].filter(Boolean).join("; ")}
>
    <a href={postUrl}>
        {cover && (
            <ImageWrapper
                class="record-cover"
                src={cover}
                alt={`${title} cover`}
                loading="lazy"
            />
        )}

        <div class="record-body">
            <div class="record-meta">
                <span>{pinned ? "Priority" : "Case file"}</span>
                <time datetime={formatDateToYYYYMMDD(new Date(published))}>{dateText}</time>
                <span>{categoryLabel}</span>
            </div>

            <h2>{title}</h2>
            <p>{description || remarkPluginFrontmatter.excerpt}</p>

            <div class="record-foot">
                <span>{remarkPluginFrontmatter.words} words</span>
                <span>{remarkPluginFrontmatter.minutes} min read</span>
                <span aria-hidden="true">Read record →</span>
            </div>
        </div>
    </a>
</article>

<style>
    .record-card {
        border-top: 1px solid rgba(216, 212, 202, 0.1);
    }

    .record-card:last-child {
        border-bottom: 1px solid rgba(216, 212, 202, 0.1);
    }

    .record-card a {
        display: block;
        padding: 1.35rem 0;
        color: inherit;
        text-decoration: none;
    }

    .record-card a:hover h2 {
        color: #eeeae1;
    }

    .record-card.has-cover {
        border-top: none;
        border: 1px solid rgba(216, 212, 202, 0.12);
        background: #060606;
        transition: border-color 180ms ease, transform 180ms ease;
    }

    .record-card.has-cover:last-child {
        border-bottom: 1px solid rgba(216, 212, 202, 0.12);
    }

    .record-card.has-cover:hover {
        border-color: rgba(112, 33, 49, 0.82);
        transform: translateY(-2px);
    }

    .record-card.has-cover a {
        display: flex;
        padding: 0;
    }

    .record-card.cover-right a {
        flex-direction: row-reverse;
    }

    .record-card.has-cover .record-cover {
        flex: 0 0 var(--cover-width, 33%);
        aspect-ratio: 4 / 3;
        align-self: stretch;
    }

    .record-card.has-cover .record-cover :global(img) {
        transition: transform 220ms ease, filter 220ms ease;
        filter: saturate(0.85) contrast(1.02);
    }

    .record-card.has-cover:hover .record-cover :global(img) {
        transform: scale(1.03);
        filter: saturate(1) contrast(1.04);
    }

    .record-card.has-cover .record-body {
        flex: 1 1 auto;
        min-width: 0;
        padding: 1.1rem 1.25rem;
    }

    .record-meta,
    .record-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem 1rem;
        color: rgba(216, 212, 202, 0.58);
        font-family: var(--font-mono);
        font-size: 0.63rem;
        text-transform: uppercase;
    }

    .record-meta span:first-child {
        color: var(--accent-strong, #702131);
    }

    .record-card h2 {
        margin: 0.65rem 0 0;
        color: rgba(244, 241, 234, 0.94);
        font-size: 1.38rem;
        font-weight: 500;
        line-height: 1.3;
    }

    .record-card p {
        margin: 0.55rem 0 0;
        color: rgba(238, 234, 225, 0.74);
        font-size: 0.98rem;
        line-height: 1.55;
    }

    .record-foot {
        margin-top: 0.85rem;
    }

    .record-foot span:last-child {
        margin-left: auto;
        color: rgba(238, 234, 225, 0.7);
    }

    @media (max-width: 520px) {
        .record-card h2 {
            font-size: 1.22rem;
        }

        .record-foot span:last-child {
            width: 100%;
            margin-left: 0;
        }

        .record-card.has-cover a,
        .record-card.cover-right a {
            flex-direction: column;
        }

        .record-card.has-cover .record-cover {
            flex-basis: auto;
            width: 100%;
            aspect-ratio: 16 / 9;
        }

        .record-card.has-cover .record-body {
            padding: 1rem;
        }
    }
</style>
