---
import { profileConfig } from "@/config";
import { url } from "@utils/url";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <p>
        Case files by {profileConfig.name} · © {currentYear}
    </p>
    <nav aria-label="Footer">
        <a href={url("rss/")}>RSS</a>
        <span aria-hidden="true">/</span>
        <a href={url("atom/")}>Atom</a>
        <span aria-hidden="true">/</span>
        <a href={url("sitemap-index.xml")}>Sitemap</a>
    </nav>
</footer>

<style>
    .site-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 5rem;
        padding: 1.35rem 0 2.5rem;
        border-top: 1px solid rgba(216, 212, 202, 0.1);
        color: rgba(216, 212, 202, 0.42);
        font-family: var(--font-mono);
        font-size: 0.67rem;
        text-transform: uppercase;
    }

    .site-footer nav {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .site-footer a {
        color: rgba(216, 212, 202, 0.58);
        text-decoration: none;
    }

    .site-footer a:hover {
        color: #d8d4ca;
    }

    @media (max-width: 640px) {
        .site-footer {
            align-items: flex-start;
            flex-direction: column;
            margin-top: 3.5rem;
        }
    }
</style>
