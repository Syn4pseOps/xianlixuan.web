---
import Icon from "@components/common/icon.astro";
import { profileConfig } from "@/config";

const currentYear = new Date().getFullYear();
const githubUrl = "https://github.com/Syn4pseOps";
---

<footer class="site-footer">
    <div class="view-counter" aria-label="Site view count">
        <Icon icon="fa6-solid:eye" class="view-counter-icon" size="xs" />
        <span class="view-counter-number" aria-busy="true">...</span>
        <span class="view-counter-label">views</span>
    </div>

    <div class="footer-action">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">
            Follow the traces
        </a>
    </div>

    <p class="footer-signature">
        Archives • {currentYear} • {profileConfig.name}
    </p>
</footer>

<script>
    const bindViewCounter = async () => {
        const counters = document.querySelectorAll<HTMLElement>(
            ".view-counter:not([data-view-counter-bound])",
        );

        await Promise.allSettled(
            Array.from(counters).map(async (counter) => {
                counter.dataset.viewCounterBound = "true";

                const namespace = "syna4pseops-website";
                const key = "site-total";
                const sessionKey = `view-counter:${namespace}:${key}`;
                let countedThisSession = false;

                try {
                    countedThisSession = sessionStorage.getItem(sessionKey) === "1";
                } catch {
                    // The counter still works when session storage is unavailable.
                }

                const action = countedThisSession ? "get" : "hit";

                try {
                    const response = await fetch(
                        `https://abacus.jasoncameron.dev/${action}/${namespace}/${key}`,
                    );
                    if (!response.ok) throw new Error(String(response.status));

                    const result = await response.json();
                    const count =
                        typeof result?.value === "number"
                            ? result.value
                            : typeof result?.count === "number"
                              ? result.count
                              : null;
                    if (count === null) throw new Error("Invalid counter response");

                    const number = counter.querySelector<HTMLElement>(
                        ".view-counter-number",
                    );
                    if (number) {
                        number.textContent = count.toLocaleString();
                        number.removeAttribute("aria-busy");
                    }

                    if (!countedThisSession) {
                        try {
                            sessionStorage.setItem(sessionKey, "1");
                        } catch {
                            // Ignore storage errors after a successful count.
                        }
                    }
                } catch {
                    counter.hidden = true;
                }
            }),
        );
    };

    bindViewCounter();
    document.addEventListener("astro:after-swap", bindViewCounter);
</script>

<style>
    .site-footer {
        margin-top: 4rem;
        padding: 1.5rem 1.5rem 6rem;
        border-top: 1px solid rgba(216, 212, 202, 0.08);
        color: rgba(216, 212, 202, 0.6);
        font-family: "Courier New", Courier, var(--font-mono);
        font-weight: 400;
        text-align: center;
        text-transform: uppercase;
    }

    .view-counter {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.64rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.24em !important;
        line-height: 1.6;
        white-space: nowrap;
    }

    .view-counter :global(.view-counter-icon) {
        position: relative;
        top: -1px;
        font-size: 0.56rem;
        opacity: 0.7;
    }

    .view-counter-label {
        margin-left: 0.125rem;
        opacity: 0.7;
    }

    .footer-action {
        margin-top: 1rem;
        font-size: 0.64rem;
        letter-spacing: 0.24em !important;
        line-height: 1.6;
    }

    .footer-action a {
        color: rgba(238, 234, 225, 0.66);
        text-decoration: none;
        transition: color 160ms ease;
    }

    .footer-action a:hover,
    .footer-action a:focus-visible {
        color: #fffdf8;
    }

    .footer-signature {
        margin: 1rem 0 0;
        font-size: 0.62rem;
        letter-spacing: 0.24em !important;
        line-height: 1.6;
    }

    @media (max-width: 640px) {
        .site-footer {
            margin-top: 3.5rem;
            padding-inline: 0.75rem;
        }

        .footer-signature {
            font-size: 0.56rem;
            letter-spacing: 0.16em !important;
        }
    }
</style>
