---
export const prerender = true;

import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/constants";
import { getSortedPosts } from "@utils/post";
import { formatDateToYYYYMMDD } from "@utils/date";
import { getPostUrl } from "@utils/url";
import Pagination from "@components/pagination.astro";
import GridLayout from "@layouts/grid.astro";

export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();
    return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const startIndex = (page.currentPage - 1) * PAGE_SIZE;
const heroName = "Syn4pseOps".split("");

const getCategoryLabel = (entry: CollectionEntry<"posts">) => {
    const category = entry.data.category;
    if (Array.isArray(category)) return category.join(" / ");
    return category || "Field Note";
};

const caseRows = page.data.map((entry: CollectionEntry<"posts">, index: number) => ({
    entry,
    caseNumber: String(startIndex + index + 1).padStart(3, "0"),
    dateValue: formatDateToYYYYMMDD(new Date(entry.data.published)),
    isLatest: index === 0 && isFirstPage,
    category: getCategoryLabel(entry),
}));

const selectedProjects = [
    {
        status: "In development",
        title: "Agentic Federation Framework",
        description: "A multi-agent AI ecosystem focused on practical coordination, tooling, and security workflows.",
        focus: "Agentic AI",
        href: "/about/",
    },
    {
        status: "Active",
        title: "Syn4pseOps Case Files",
        description: "The public lab notebook behind this site: event records, technical notes, and documented lessons.",
        focus: "Research log",
        href: "/blog/",
    },
    {
        status: "Ongoing",
        title: "Offensive Security Labs",
        description: "Hands-on practice across web security, Active Directory, digital forensics, and CTF challenges.",
        focus: "Security labs",
        href: "/archive/",
    },
];
---

<GridLayout>
    {isFirstPage && (
        <section class="index-hero" aria-labelledby="site-title">
            <img
                class="index-brandmark"
                src="/assets/brand/syna4pseops-mark.png"
                alt=""
                width="512"
                height="512"
                aria-hidden="true"
            />
            <h1 id="site-title" class="notranslate" aria-label="Syn4pseOps">
                <span class="index-title-letters" aria-hidden="true">
                    {heroName.map((letter) => <span>{letter}</span>)}
                </span>
            </h1>
            <p class="index-role notranslate">A journey through cybersecurity, code, trials, and the unknown.</p>

            <div class="index-rule" aria-hidden="true"></div>

            <dl class="index-stats">
                <div>
                    <dt>Status</dt>
                    <dd>CS Student</dd>
                </div>
                <div>
                    <dt>Case Files</dt>
                    <dd>{page.total}</dd>
                </div>
                <div>
                    <dt>Credentials</dt>
                    <dd>7</dd>
                </div>
                <div>
                    <dt>Base</dt>
                    <dd>Thailand</dd>
                </div>
            </dl>
        </section>
    )}

    <section class="case-index" aria-labelledby="case-index-title">
        <h2 id="case-index-title">Index of Recent Cases</h2>

        <div class="case-list">
            {caseRows.map((row) => (
                <a class="case-row" href={getPostUrl(row.entry)}>
                    <span class="case-status">{row.isLatest ? "Latest" : ""}</span>
                    <span class="case-number">No. {row.caseNumber}</span>
                    <time datetime={row.dateValue}>{row.dateValue.replaceAll("-", ".")}</time>
                    <strong class="notranslate" translate="no">{row.entry.data.title}</strong>
                    <span class="case-category">{row.category}</span>
                </a>
            ))}
        </div>

        <a class="full-index-link" href="/blog/">Full index <span aria-hidden="true">→</span></a>
    </section>

    {isFirstPage && (
        <section class="project-index" aria-labelledby="project-index-title">
            <div class="project-index-heading">
                <h2 id="project-index-title">Selected Projects</h2>
                <p>Current work and active research</p>
            </div>

            <div class="project-list">
                {selectedProjects.map((project) => (
                    <a class="project-row" href={project.href}>
                        <span class="project-status">{project.status}</span>
                        <span class="project-copy">
                            <strong>{project.title}</strong>
                            <span>{project.description}</span>
                        </span>
                        <span class="project-focus">{project.focus}</span>
                        <span class="project-arrow" aria-hidden="true">→</span>
                    </a>
                ))}
            </div>
        </section>
    )}

    {page.lastPage > 1 && (
        <Pagination class="mx-auto onload-animation-up" page={page} />
    )}
</GridLayout>

<style>
    .index-hero {
        min-height: 19rem;
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        padding: 1rem 0 3.5rem;
        text-align: center;
    }

    .index-brandmark {
        display: block;
        width: 7.5rem;
        height: 7.5rem;
        object-fit: contain;
        opacity: 0.78;
    }

    .index-hero h1 {
        margin: 1.25rem 0 0;
        color: rgba(216, 212, 202, 0.64);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 400;
        line-height: 1.5;
        text-transform: uppercase;
    }

    .index-title-letters {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.57rem;
    }

    .index-role {
        max-width: 36rem;
        margin: 0.5rem 1rem 0;
        color: rgba(216, 212, 202, 0.42);
        font-size: 0.98rem;
        font-style: italic;
        line-height: 1.5;
        text-wrap: balance;
    }

    .index-rule {
        width: 4.5rem;
        height: 1px;
        margin: 1.5rem auto 1.3rem;
        background: var(--accent-strong, #702131);
    }

    .index-stats {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        color: rgba(216, 212, 202, 0.42);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        text-transform: uppercase;
    }

    .index-stats div {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .index-stats div + div::before {
        content: "/";
        margin: 0 0.65rem;
        color: rgba(216, 212, 202, 0.18);
    }

    .index-stats dt,
    .index-stats dd {
        margin: 0;
    }

    .index-stats dd {
        color: rgba(216, 212, 202, 0.72);
    }

    .case-index {
        width: min(100%, 48rem);
        margin: 0 auto;
    }

    .case-index h2 {
        margin: 0 0 1rem;
        color: rgba(216, 212, 202, 0.58);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 500;
        text-align: center;
        text-transform: uppercase;
    }

    .case-list {
        border-top: 1px solid rgba(216, 212, 202, 0.08);
    }

    .case-row {
        display: grid;
        grid-template-columns: 3.25rem 4.4rem 5.6rem minmax(0, 1fr) 7.5rem;
        align-items: baseline;
        min-height: 3rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(216, 212, 202, 0.08);
        color: rgba(216, 212, 202, 0.54);
        text-decoration: none;
        transition: color 160ms ease, background-color 160ms ease;
    }

    .case-row:hover {
        color: #d8d4ca;
        background: rgba(216, 212, 202, 0.025);
    }

    .case-status,
    .case-number,
    .case-row time,
    .case-category {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        text-transform: uppercase;
    }

    .case-status {
        color: var(--accent-strong, #702131);
    }

    .case-number,
    .case-row time {
        color: rgba(216, 212, 202, 0.32);
    }

    .case-row strong {
        min-width: 0;
        padding-right: 1rem;
        color: rgba(216, 212, 202, 0.76);
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 500;
        overflow-wrap: anywhere;
    }

    .case-category {
        color: rgba(216, 212, 202, 0.38);
        text-align: right;
    }

    .full-index-link {
        display: block;
        width: max-content;
        margin: 1.4rem auto 0;
        color: rgba(216, 212, 202, 0.48);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        text-decoration: none;
        text-transform: uppercase;
    }

    .full-index-link:hover {
        color: #d8d4ca;
    }

    .project-index {
        width: min(100%, 48rem);
        margin: 4.5rem auto 0;
    }

    .project-index-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.85rem;
    }

    .project-index-heading h2,
    .project-index-heading p {
        margin: 0;
        font-family: var(--font-mono);
        font-weight: 500;
        text-transform: uppercase;
    }

    .project-index-heading h2 {
        color: rgba(216, 212, 202, 0.7);
        font-size: 0.74rem;
    }

    .project-index-heading p {
        color: rgba(216, 212, 202, 0.48);
        font-size: 0.74rem;
    }

    .project-list {
        border-top: 1px solid rgba(216, 212, 202, 0.1);
    }

    .project-row {
        display: grid;
        grid-template-columns: 7.5rem minmax(0, 1fr) 7rem 1.5rem;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(216, 212, 202, 0.1);
        color: inherit;
        text-decoration: none;
        transition: background-color 160ms ease;
    }

    .project-row:hover {
        background: rgba(216, 212, 202, 0.025);
    }

    .project-status,
    .project-focus,
    .project-arrow {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        text-transform: uppercase;
    }

    .project-status {
        color: var(--accent-strong, #702131);
    }

    .project-copy {
        display: grid;
        gap: 0.2rem;
        min-width: 0;
    }

    .project-copy strong {
        color: rgba(216, 212, 202, 0.86);
        font-size: 1rem;
        font-weight: 500;
    }

    .project-copy > span {
        color: rgba(216, 212, 202, 0.58);
        font-size: 0.86rem;
        line-height: 1.45;
    }

    .project-focus {
        color: rgba(216, 212, 202, 0.48);
        text-align: right;
    }

    .project-arrow {
        color: rgba(216, 212, 202, 0.48);
        text-align: right;
        transition: color 160ms ease, transform 160ms ease;
    }

    .project-row:hover .project-arrow {
        color: var(--accent-strong, #702131);
        transform: translateX(0.2rem);
    }

    @media (max-width: 760px) {
        .index-hero {
            min-height: 17rem;
            padding-bottom: 2.75rem;
        }

        .index-brandmark {
            width: 6rem;
            height: 6rem;
        }

        .index-title-letters {
            gap: 0.42rem;
        }

        .index-role {
            max-width: 22rem;
            font-size: 0.92rem;
        }

        .index-stats {
            display: grid;
            grid-template-columns: repeat(2, max-content);
            gap: 0.55rem 1.2rem;
        }

        .index-stats div + div::before {
            display: none;
        }

        .case-row {
            grid-template-columns: 4.2rem minmax(0, 1fr);
            gap: 0.25rem 0.65rem;
            padding: 0.9rem 0;
        }

        .case-status {
            grid-column: 1;
            grid-row: 1;
        }

        .case-number {
            grid-column: 1;
            grid-row: 2;
        }

        .case-row time {
            grid-column: 1;
            grid-row: 3;
        }

        .case-row strong {
            grid-column: 2;
            grid-row: 1 / span 2;
            align-self: center;
            padding-right: 0;
        }

        .case-category {
            grid-column: 2;
            grid-row: 3;
            text-align: left;
        }

        .project-index {
            margin-top: 3.75rem;
        }

        .project-index-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.25rem;
        }

        .project-row {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 0.45rem 0.75rem;
        }

        .project-status {
            grid-column: 1;
            grid-row: 1;
        }

        .project-copy {
            grid-column: 1 / -1;
            grid-row: 2;
        }

        .project-focus {
            grid-column: 1;
            grid-row: 3;
            text-align: left;
        }

        .project-arrow {
            grid-column: 2;
            grid-row: 1;
        }
    }
</style>
