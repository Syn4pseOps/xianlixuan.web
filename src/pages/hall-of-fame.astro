---
export const prerender = true;

import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import GridLayout from "@layouts/grid.astro";

const pageTitle = LinkPresets[LinkPreset.HallOfFame].name;
const pageDescription = LinkPresets[LinkPreset.HallOfFame].description;

type Achievement = {
    title: string;
    officialTitle: string;
    description?: string;
    issuer: string;
    issued: string;
    year: string;
    category: string;
    tier: "gold" | "silver" | "bronze";
    proof: string[];
    preview: string;
    credential: string;
    fileKind: "PDF" | "IMAGE";
};

const achievements: Achievement[] = [
    {
        title: "CTF Boot Camp #4",
        officialTitle: "CTF Boot Camp #4 - Cybersecurity Workshop Certificate",
        description: "Completed an intensive hands-on cybersecurity workshop focused on CTF challenges, security fundamentals, and vulnerability analysis.",
        issuer: "National Cyber Security Agency (NCSA)",
        issued: "Jul 5, 2026",
        year: "2026",
        category: "Hands-on workshop",
        tier: "silver",
        proof: ["2-day practical workshop", "CTF & vulnerability analysis", "NCSA-issued"],
        preview: "/assets/hall-of-fame/ncsa-ctf-boot-camp-4.jpg",
        credential: "/assets/hall-of-fame/ncsa-ctf-boot-camp-4.jpg",
        fileKind: "IMAGE",
    },
    {
        title: "Cisco Ethical Hacker",
        officialTitle: "Ethical Hacker",
        issuer: "Cisco Networking Academy",
        issued: "Jun 16, 2026",
        year: "2026",
        category: "Role-aligned course",
        tier: "gold",
        proof: ["Cisco Networking Academy", "Verified certificate", "Professional-aligned track"],
        preview: "/assets/hall-of-fame/cisco-ethical-hacker.png",
        credential: "/assets/hall-of-fame/cisco-ethical-hacker.pdf",
        fileKind: "PDF",
    },
    {
        title: "Cybersecurity Foundation Course",
        officialTitle: "ด้านความมั่นคงปลอดภัยไซเบอร์ ระดับพื้นฐาน",
        issuer: "NCSA e-Learning / THNCA",
        issued: "Apr 25, 2026",
        year: "2026",
        category: "Foundation course",
        tier: "silver",
        proof: ["21 hours", "Verification code shown", "NCSA-issued"],
        preview: "/assets/hall-of-fame/ncsa-foundation-course.png",
        credential: "/assets/hall-of-fame/ncsa-foundation-course.png",
        fileKind: "IMAGE",
    },
    {
        title: "Cisco Introduction to Cybersecurity",
        officialTitle: "Introduction to Cybersecurity",
        issuer: "Cisco Networking Academy",
        issued: "May 5, 2026",
        year: "2026",
        category: "Foundation course",
        tier: "silver",
        proof: ["Student level credential", "Verified badge", "Cisco Networking Academy"],
        preview: "/assets/hall-of-fame/cisco-introduction-to-cybersecurity.png",
        credential: "/assets/hall-of-fame/cisco-introduction-to-cybersecurity.png",
        fileKind: "IMAGE",
    },
    {
        title: "NCSA CTF Boot Camp",
        officialTitle: "NCSA CTF BOOT CAMP",
        issuer: "NCSA / THNCA",
        issued: "Apr 26, 2026",
        year: "2026",
        category: "Hands-on training",
        tier: "bronze",
        proof: ["Boot camp format", "Completion certificate", "NCSA training"],
        preview: "/assets/hall-of-fame/ncsa-ctf-bootcamp.jpg",
        credential: "/assets/hall-of-fame/ncsa-ctf-bootcamp.jpg",
        fileKind: "IMAGE",
    },
    {
        title: "MOOC Basic Cybersecurity",
        officialTitle: "Basic Cybersecurity",
        issuer: "MOOC Cybersecurity Learning Platform",
        issued: "May 6, 2026",
        year: "2026",
        category: "Course completion",
        tier: "bronze",
        proof: ["Completion certificate", "Certificate ID shown", "NCSA Thailand ecosystem"],
        preview: "/assets/hall-of-fame/mooc-basic-cybersecurity.jpg",
        credential: "/assets/hall-of-fame/mooc-basic-cybersecurity.jpg",
        fileKind: "IMAGE",
    },
    {
        title: "Hack The Scammer CTF 2025",
        officialTitle: "เข้าร่วมกิจกรรมการแข่งขัน HACK THE SCAMMER CTF 2025",
        issuer: "NCSA / Ministry of Digital Economy and Society",
        issued: "Dec 20, 2025",
        year: "2025",
        category: "Competition participation",
        tier: "bronze",
        proof: ["Competition participation", "Online event", "No ranking stated"],
        preview: "/assets/hall-of-fame/hack-the-scammer-ctf-2025.png",
        credential: "/assets/hall-of-fame/hack-the-scammer-ctf-2025.pdf",
        fileKind: "PDF",
    },
];

const yearGroups = Object.entries(
    achievements.reduce((groups, item) => {
        (groups[item.year] ??= []).push(item);
        return groups;
    }, {} as Record<string, Achievement[]>),
).sort(([left], [right]) => Number(right) - Number(left));
---

<GridLayout title={pageTitle} description={pageDescription}>
    <header class="page-index-header hof-header">
        <h1>Exhibits</h1>
        <p>{achievements.length} credentials on record</p>
    </header>

    <div class="hof-record">
        {yearGroups.map(([year, items]) => (
            <section class="hof-year" aria-labelledby={`year-${year}`}>
                <h2 id={`year-${year}`}>{year}</h2>

                <div class="hof-grid">
                    {items.map((item) => {
                        const exhibitNumber = achievements.indexOf(item) + 1;
                        return (
                            <article class="hof-card">
                                <a class="hof-preview" href={item.credential} target="_blank" rel="noopener noreferrer">
                                    <img src={item.preview} alt={`${item.title} certificate preview`} loading="lazy" />
                                </a>

                                <div class="hof-card-body">
                                    <div class="hof-labels">
                                        <span>Exhibit No. {String(exhibitNumber).padStart(2, "0")}</span>
                                        <span>{item.tier} · {item.fileKind}</span>
                                    </div>

                                    <h3>{item.title}</h3>
                                    <p class="hof-issuer">{item.issuer} · {item.issued}</p>
                                    <p class="hof-official">{item.officialTitle}</p>
                                    {item.description && <p class="hof-description">{item.description}</p>}

                                    <ul class="hof-proof">
                                        {item.proof.map((proof) => <li>{proof}</li>)}
                                    </ul>

                                    <a class="hof-open" href={item.credential} target="_blank" rel="noopener noreferrer">
                                        Open record <span aria-hidden="true">↗</span>
                                    </a>
                                </div>
                            </article>
                        );
                    })}
                </div>
            </section>
        ))}
    </div>
</GridLayout>

<style>
    .hof-header {
        margin-bottom: 2.75rem;
    }

    .hof-record {
        display: grid;
        gap: 3.75rem;
    }

    .hof-year h2 {
        margin: 0 0 0.9rem;
        color: rgba(216, 212, 202, 0.56);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 500;
        text-align: center;
    }

    .hof-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .hof-card {
        min-width: 0;
        border: 1px solid rgba(216, 212, 202, 0.12);
        background: #060606;
        transition: border-color 180ms ease, transform 180ms ease;
    }

    .hof-card:hover {
        border-color: rgba(112, 33, 49, 0.82);
        transform: translateY(-2px);
    }

    .hof-preview {
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-bottom: 1px solid rgba(216, 212, 202, 0.1);
        background: #080808;
    }

    .hof-preview img {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0.7rem;
        object-fit: contain;
        filter: grayscale(1) contrast(0.92);
        transition: filter 180ms ease;
    }

    .hof-card:hover .hof-preview img {
        filter: grayscale(0.35) contrast(0.96);
    }

    .hof-card-body {
        padding: 1rem;
    }

    .hof-labels {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        color: var(--accent-strong, #702131);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        text-transform: uppercase;
    }

    .hof-labels span:last-child {
        color: rgba(216, 212, 202, 0.32);
        text-align: right;
    }

    .hof-card h3 {
        margin: 0.8rem 0 0;
        color: rgba(216, 212, 202, 0.9);
        font-size: 1.16rem;
        font-weight: 500;
        line-height: 1.28;
        overflow-wrap: anywhere;
    }

    .hof-issuer,
    .hof-official,
    .hof-description {
        margin: 0.45rem 0 0;
        line-height: 1.48;
    }

    .hof-issuer {
        color: rgba(216, 212, 202, 0.54);
        font-family: var(--font-mono);
        font-size: 0.76rem;
    }

    .hof-official {
        color: rgba(216, 212, 202, 0.64);
        font-size: 0.9rem;
    }

    .hof-description {
        color: rgba(216, 212, 202, 0.58);
        font-size: 0.84rem;
    }

    .hof-proof {
        margin: 0.85rem 0 0;
        padding: 0;
        list-style: none;
        color: rgba(216, 212, 202, 0.5);
        font-family: var(--font-mono);
        font-size: 0.74rem;
    }

    .hof-proof li + li {
        margin-top: 0.28rem;
    }

    .hof-proof li::before {
        content: "·";
        margin-right: 0.4rem;
        color: var(--accent-strong, #702131);
    }

    .hof-open {
        display: inline-block;
        margin-top: 1rem;
        color: rgba(216, 212, 202, 0.58);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        text-decoration: none;
        text-transform: uppercase;
    }

    .hof-open:hover {
        color: #d8d4ca;
    }

    @media (max-width: 820px) {
        .hof-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 540px) {
        .hof-record {
            gap: 2.75rem;
        }

        .hof-grid {
            grid-template-columns: 1fr;
        }

        .hof-preview {
            aspect-ratio: 16 / 9;
        }

        .hof-card-body {
            padding: 0.85rem;
        }

        .hof-card h3 {
            margin-top: 0.65rem;
            font-size: 1.06rem;
        }

        .hof-description,
        .hof-proof {
            display: none;
        }

        .hof-open {
            margin-top: 0.75rem;
        }
    }
</style>
